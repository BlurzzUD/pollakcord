@@ -0,0 +1,32 @@
+from sqlalchemy.ext.asyncio import AsyncSession
+
+from ..db.types import utcnow
+from ..errors import AppError
+from ..models import Conversation, User
+from ..models.enums import ChannelType
+from . import privacy
+from .permissions import Perm, load_channel_context
+
+
+async def require_media_scope(db: AsyncSession, user: User, scope: str, scope_id: int, *, write: bool) -> None:
+    if not 0 < scope_id < 2**63:
+        raise AppError("not_found", 404)
+    if scope == "channel":
+        channel, context = await load_channel_context(db, scope_id, user.id)
+        if channel.type != ChannelType.TEXT.value:
+            raise AppError("channel_type_invalid", 422)
+        if write and context.member.timeout_until is not None and context.member.timeout_until > utcnow():
+            raise AppError("timed_out", 403)
+        context.require_in(channel, Perm.SEND_MESSAGES if write else Perm.READ_MESSAGE_HISTORY)
+        return
+    if scope != "dm":
+        raise AppError("not_found", 404)
+    conversation = await db.get(Conversation, scope_id)
+    if conversation is None or user.id not in (conversation.user_low_id, conversation.user_high_id):
+        raise AppError("not_found", 404)
+    if write:
+        other_id = conversation.user_high_id if user.id == conversation.user_low_id else conversation.user_low_id
+        relation = await privacy.relation(db, user.id, other_id)
+        preferences = await privacy.get_settings_row(db, other_id)
+        if not privacy.can_direct_message(relation, preferences):
+            raise AppError("dm_not_allowed", 403)
diff --git a/backend/app/services/message_media.py b/backend/app/services/message_media.py
new file mode 100644
index 0000000..8e63422
--- /dev/null
+++ b/backend/app/services/message_media.py
@@ -0,0 +1,33 @@
+import json
+import re
+
+from ..config import Settings
+from ..crypto.envelope import DecryptionError, Vault
+from ..errors import AppError
+
+GIPHY_ID = re.compile(r"^[A-Za-z0-9]{1,64}$")
+
+
+def validate_giphy(giphy_id: str | None, settings: Settings) -> None:
+    if giphy_id is None:
+        return
+    if not settings.giphy_api_key or not settings.giphy_api_key.get_secret_value().strip():
+        raise AppError("giphy_disabled", 503)
+    if not GIPHY_ID.fullmatch(giphy_id):
+        raise AppError("validation_error", 422)
+
+
+def seal_media(vault: Vault, domain: str, message_id: int, embeds: list[dict], giphy_id: str | None = None) -> tuple[bytes | None, str | None]:
+    if not embeds and giphy_id is None:
+        return None, None
+    payload = json.dumps({"embeds": embeds, "giphy_id": giphy_id}, ensure_ascii=False).encode("utf-8")
+    return vault.encrypt("message-media", payload, f"{domain}|{message_id}".encode())
+
+
+def open_media(vault: Vault, domain: str, message_id: int, blob: bytes | None, key_id: str | None) -> dict:
+    if blob is None or key_id is None:
+        return {"embeds": [], "giphy_id": None}
+    try:
+        return json.loads(vault.decrypt("message-media", blob, f"{domain}|{message_id}".encode(), key_id))
+    except (DecryptionError, ValueError, UnicodeError):
+        return {"embeds": [], "giphy_id": None}
